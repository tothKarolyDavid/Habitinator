@namespace App.Shared.RCL.Components.Dialogs
@using App.Shared.RCL.Models
@using App.Shared.RCL.Services
@using Microsoft.JSInterop
@using Microsoft.Extensions.DependencyInjection
@inject IActivityStatisticsReader Stats
@inject IUserTimeZoneService TimeZoneService
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject IUserDateFormatService DateFormatService
@inject IUserNotifier Notifier
@inject IServiceProvider ServiceProvider

<MudDialog Class="daily-heatmap-dialog hab-modal-dialog" ContentClass="daily-heatmap-dialog__content" Style="width: min(36rem, calc(100vw - 1rem));">
    <DialogContent>
        <div class="hab-modal hab-modal--daily" @onclick:stopPropagation="true">
            <div class="hab-modal__header">
                <div class="hab-modal__topbar hab-modal__topbar--minimal">
                    <button type="button" class="hab-modal__close" aria-label="Close" title="Close" @onclick="() => MudDialog.Close()">
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="letter-spacing:-0.02em;">@DisplayTitle</MudText>
                    @if (_graph is not null)
                    {
                        <span class="stats-habit-ratio" title="@RatioTooltip">@RatioLabel</span>
                    }
                </div>
                @if (_periodOptions.Count > 1)
                {
                    <div class="stats-segment mt-3" role="tablist" aria-label="Period">
                        @foreach (var opt in _periodOptions)
                        {
                            <button type="button" role="tab" @attributes="GetPeriodTabAttrs(opt.Key)" class="stats-segment__btn @(_selectedPeriodKey == opt.Key ? "stats-segment__btn--active" : string.Empty)" @onclick="() => OnPeriodChangedAsync(opt.Key)">@opt.Label</button>
                        }
                    </div>
                }
            </div>

            <div class="hab-modal__body" style="padding-top:0.9rem;">
                @if (_loading)
                {
                    <div class="pa-2">
                        <MudSkeleton Width="100%" Height="110px" SkeletonType="SkeletonType.Rectangle" />
                        <MudSkeleton Width="60%" Height="14px" Class="mt-3" />
                    </div>
                }
                else if (_error is not null)
                {
                    <div class="dialog-inline-fallback">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Large" Class="dialog-inline-fallback__icon" />
                        <MudText Typo="Typo.subtitle2" Class="dialog-inline-fallback__title">Could not load heatmap</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Try again or pick a different period.</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="LoadDataAsync">Retry</MudButton>
                    </div>
                }
                else if (_graph is not null)
                {
                    <div class="daily-heatmap-grid-container">
                        <StatsHeatmapGrid Columns="_graph.GridWeekColumns"
                                           ContainerClass="stats-heatmap-container--large"
                                           ShowMonthLabels="false"
                                           Cells="_cellIndex"
                                           IsToday="@((r, c) => _cellIndex.TryGetValue((r, c), out var cell) && IsHeatmapToday(cell.Date))"
                                           GetCellClass="@((r, c) => DailyHeatmapCellClass(_cellIndex[(r, c)]))"
                                           GetCellTitle="@((r, c) => DailyHeatmapDayTitle(_cellIndex[(r, c)].Date, _cellIndex[(r, c)].Count))"
                                           GetCellAriaLabel="@((r, c) => DailyHeatmapDayTitle(_cellIndex[(r, c)].Date, _cellIndex[(r, c)].Count))"
                                           OnCellClick="OnCellClickAsync"/>
                    </div>
                }
                else
                {
                    <div class="stats-empty">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Large" Class="stats-empty__icon" />
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">No heatmap yet</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Complete this daily to build its history.</MudText>
                    </div>
                }
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }
    [Parameter] [EditorRequired] public Guid BoardItemId { get; set; }
    [Parameter] public string Title { get; set; } = "Daily";

    private string _selectedPeriodKey = DailyGraphPeriods.Rolling370Days;
    private IReadOnlyList<DailyGraphPeriodOption> _periodOptions = [];
    private DailyContributionGraphDto? _graph;
    private Dictionary<(int R, int C), ActivityHeatmapCellDto> _cellIndex = [];
    private bool _loading = true;
    private string? _error;
    private DateOnly _heatmapToday;

    private string DisplayTitle => string.IsNullOrWhiteSpace(Title) ? "Daily" : Title;
    private string RatioLabel
    {
        get
        {
            if (_graph is null) return string.Empty;
            var active = _graph.Heatmap.Count(x => x.InDataRange && x.Count > 0);
            var total = _graph.Heatmap.Count(x => x.InDataRange);
            var pct = total == 0 ? 0 : (int)Math.Round(100.0 * active / total);
            return $"{active} of {total} · {pct}%";
        }
    }
    private string RatioTooltip
    {
        get
        {
            if (_graph is null) return string.Empty;
            var active = _graph.Heatmap.Count(x => x.InDataRange && x.Count > 0);
            var total = _graph.Heatmap.Count(x => x.InDataRange);
            return $"{active} active of {total} in this period";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await DateFormatService.InitializeAsync();
        _heatmapToday = DailySchedule.LocalToday(TimeZoneService);
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_graph is not null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("scrollHeatmapsToEnd");
            }
            catch (Exception ex)
            {
                // Ignore JS invocation failures in non-browser context
                _ = ex;
            }
        }
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var data = await Stats.GetDailyContributionsAsync(_selectedPeriodKey);
            ApplyContributionData(data);
        }
        catch (Exception ex)
        {
            if (await TryLoadOfflineFallbackAsync())
            {
                return;
            }

            _error = ex.Message;
            await NotifySafeAsync("Could not load daily history. Please try again.", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyContributionData(DailyContributionsViewDto data)
    {
        _periodOptions = data.PeriodOptions;
        if (!string.IsNullOrEmpty(data.PeriodKey))
        {
            _selectedPeriodKey = data.PeriodKey;
        }

        _graph = data.Graphs.FirstOrDefault(g => g.BoardItemId == BoardItemId)
                 ?? (!string.IsNullOrWhiteSpace(Title)
                     ? data.Graphs.FirstOrDefault(g => string.Equals(g.Title, Title, StringComparison.OrdinalIgnoreCase))
                     : null);

        if (_graph is not null)
        {
            _cellIndex = _graph.Heatmap.ToDictionary(x => (x.DayRow, x.WeekCol));
            _periodOptions = _periodOptions.Where(o => _graph.AvailablePeriodKeys.Contains(o.Key)).ToList();
        }
        else
        {
            _cellIndex = [];
        }
    }

    private async Task<bool> TryLoadOfflineFallbackAsync()
    {
        var offline = ServiceProvider.GetService<OfflineActivityStatisticsProvider>();
        if (offline is null)
        {
            return false;
        }

        try
        {
            var data = await offline.BuildDailyContributionsAsync(_selectedPeriodKey, null);
            ApplyContributionData(data);
            _error = null;
            await NotifySafeAsync("Offline: showing locally computed heatmap.", MudBlazor.Severity.Warning);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private async Task NotifySafeAsync(string message, MudBlazor.Severity severity)
    {
        try
        {
            await Notifier.NotifyAsync(message, severity);
        }
        catch
        {
            // Best-effort toast
        }
    }

    private async Task OnPeriodChangedAsync(string newPeriod)
    {
        _selectedPeriodKey = newPeriod;
        await LoadDataAsync();
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollHeatmapsToEnd");
        }
        catch (Exception ex)
        {
            // Ignore JS invocation failures in non-browser context
            _ = ex;
        }
    }

    private Dictionary<string, object> GetPeriodTabAttrs(string key) => new()
    {
        { "aria-selected", _selectedPeriodKey == key ? "true" : "false" }
    };
    private bool IsHeatmapToday(DateOnly date) => date == _heatmapToday;
    private string DailyHeatmapCellClass(ActivityHeatmapCellDto cell) => $"stats-cell stats-lvl-{cell.Intensity}{(IsHeatmapToday(cell.Date) ? " stats-heatmap-day--today" : "")}";
    private string DailyHeatmapDayTitle(DateOnly date, int count)
    {
        var status = count > 0 ? "Done" : "Not done";
        var dateStr = DateFormatService.Format(date);
        var baseTitle = $"{dateStr} · {status}";
        return IsHeatmapToday(date) ? $"Today · {baseTitle}" : baseTitle;
    }
    private async Task OnCellClickAsync(int row, int col)
    {
        if (_cellIndex.TryGetValue((row, col), out var cell) && cell.InDataRange)
        {
            var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
            var parameters = new DialogParameters<ActivityDayDetailDialog> { { x => x.Date, cell.Date } };
            var dateStr = DateFormatService.Format(cell.Date);
            await DialogService.ShowAsync<ActivityDayDetailDialog>($"{cell.Date.DayOfWeek} · {dateStr}", parameters, options);
        }
    }
}
