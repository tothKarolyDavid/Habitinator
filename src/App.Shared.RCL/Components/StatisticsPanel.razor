@using System.Globalization
@using Microsoft.JSInterop
@using App.Shared.RCL.Components.Dialogs
@using App.Shared.RCL.Models
@inject IActivityStatisticsReader Stats
@inject IBoardDataService BoardData
@inject IDialogService DialogService
@inject IUserDateFormatService DateFormatService
@inject IUserTimeZoneService TimeZoneService
@inject IUserNotifier Notifier
@inject IJSRuntime JSRuntime
@inject PersistentComponentState ApplicationState
@implements IDisposable

<MudStack Spacing="2" Class="stats-panel">

    @if (_error is not null)
    {
        <div class="stats-load-fallback">
            <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Large" Class="stats-load-fallback__icon" />
            <MudText Typo="Typo.subtitle2" Class="stats-load-fallback__title">We couldn't load your stats</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Check your connection and try again, or change the filters.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="@(() => RefreshAsync(() => LoadStatisticsAsync(_selectedPeriodKey)))">Retry</MudButton>
        </div>
    }
    else if (_loading)
    {
        <div class="stats-hero-skeleton">
            <MudPaper Class="pa-4 stats-dashboard-card stats-hero-card" Elevation="0" Outlined="true">
                <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3">
                    <div>
                        <MudSkeleton Width="120px" Height="14px" Class="mb-1" />
                        <MudSkeleton Width="180px" Height="22px" Class="mb-1" />
                        <MudSkeleton Width="260px" Height="14px" />
                    </div>
                    <MudSkeleton Width="160px" Height="24px" />
                </div>
                <MudSkeleton Width="100%" Height="140px" SkeletonType="SkeletonType.Rectangle" />
                <div class="stats-weekly-grid mt-3">
                    @for (int i = 0; i < 3; i++) { <MudSkeleton Height="72px" /> }
                </div>
            </MudPaper>
        </div>
        <div class="stats-kpi-strip stats-kpi-strip--mobile mt-2">
            <div class="stats-kpi-strip__grid">
                @for (int i = 0; i < 4; i++) {
                    <div class="stats-kpi-strip__item"><MudSkeleton Width="72px" Height="18px" /></div>
                }
            </div>
        </div>
    }
    else if (_data is null)
    {
        <MudPaper Class="pa-6 stats-dashboard-card text-center" Elevation="0" Outlined="true">
            <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Large" Class="mb-2" Color="Color.Secondary" />
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">No activity yet</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Complete a habit, daily or focus session and your heatmap will appear here.</MudText>
        </MudPaper>
    }
    else
    {
        <!-- Hero heatmap -->
        <MudPaper Class="pa-4 stats-dashboard-card stats-hero-card" Elevation="0" Outlined="true">
            <div class="stats-hero-head">
                <div class="stats-hero-head__titles">
                    <MudText Typo="Typo.h6" Class="stats-hero-title">Activity heatmap</MudText>
                </div>
            </div>

            <StatsHeatmapGrid Columns="_data.GridWeekColumns"
                               ContainerClass="stats-heatmap-container--large"
                               IncludeRovingTabindex="true"
                               ShowMonthLabels="false"
                               Cells="_cellIndex"
                               IsToday="@((r, c) => _cellIndex.TryGetValue((r, c), out var cell) && IsHeatmapToday(cell.Date))"
                               GetCellClass="@((r, c) => ActivityHeatmapCellClass(_cellIndex[(r, c)]))"
                               GetCellTitle="@((r, c) => HeatmapDayTitle(_cellIndex[(r, c)].Date, _cellIndex[(r, c)].Count))"
                               OnCellClick="@((r, c) => OpenDayDetailAsync(_cellIndex[(r, c)].Date))"/>


        </MudPaper>

        <!-- KPI strip shows on all widths now, sidebar keeps desktop cards as well for density -->
        <div class="stats-kpi-strip">
            <div class="stats-kpi-strip__grid">
                @foreach (var kpi in Kpis(_data))
                {
                    <div class="stats-kpi-strip__item @kpi.StripAccent">
                        <div class="stats-kpi-strip__head">
                            <span class="stats-kpi-strip__label">@kpi.StripLabel</span>
                            <MudIcon Icon="@kpi.Icon" Class="stats-kpi-strip__icon" Size="Size.Small" aria-hidden="true"/>
                        </div>
                        <span class="@($"stats-kpi-strip__value {kpi.StripValueClass}".Trim())" title="@kpi.StripTitle()">@kpi.StripValue()</span>
                    </div>
                }
            </div>
        </div>

        <div class="stats-dashboard-layout">
            <div class="stats-dashboard-main">

                <!-- Weekly sparkline -->
                <MudPaper Class="pa-4 stats-dashboard-card" Elevation="0" Outlined="true">
                    <div class="stats-section-head">
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Activity by week</MudText>
                        </div>
                    </div>
                    <div class="stats-week-bars" style="--stats-week-bar-max: @(_weekBarMax == 0 ? 1 : _weekBarMax);">
                        @foreach (var w in _data.WeekBars)
                        {
                            var h = _weekBarMax == 0 ? 0 : (int)Math.Round(100.0 * w.EventCount / _weekBarMax);
                            var scale = (h / 100.0).ToString(CultureInfo.InvariantCulture);
                            <div class="stats-week-bar-wrap" title="@FormatWeekBarTooltip(w)" tabindex="0" role="img" aria-label="@FormatWeekBarTooltip(w)">
                                <div class="stats-week-bar" style="--bar-scale: @scale"></div>
                                @if (w.FocusMinutes > 0)
                                {
                                    <div class="stats-week-bar__focus" style="--bar-scale: @scale" title="@w.FocusMinutes min focus"></div>
                                }
                            </div>
                        }
                    </div>
                </MudPaper>

                <!-- Unified consistency -->
                <MudPaper Class="pa-4 stats-dashboard-card mt-4" Elevation="0" Outlined="true">
                    <div class="stats-section-head">
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Consistency by item</MudText>
                        </div>
                        <div class="stats-segment" role="tablist" aria-label="Filter consistency graphs">
                            <button type="button" role="tab" @attributes='GetConsistencyTabAttrs("all")' class="stats-segment__btn @(_consistencyTab == "all" ? "stats-segment__btn--active" : string.Empty)" @onclick='() => _consistencyTab = "all"'>All</button>
                            <button type="button" role="tab" @attributes='GetConsistencyTabAttrs("daily")' class="stats-segment__btn @(_consistencyTab == "daily" ? "stats-segment__btn--active" : string.Empty)" @onclick='() => _consistencyTab = "daily"'>Dailies</button>
                            <button type="button" role="tab" @attributes='GetConsistencyTabAttrs("habit")' class="stats-segment__btn @(_consistencyTab == "habit" ? "stats-segment__btn--active" : string.Empty)" @onclick='() => _consistencyTab = "habit"'>Habits</button>
                        </div>
                    </div>

                    @if (_loadingDailies || _loadingHabits)
                    {
                        <MudGrid Spacing="3" Class="mt-3">
                            @for (int i = 0; i < 2; i++)
                            {
                                <MudItem xs="12" md="6">
                                    <div class="pa-3 border rounded stats-block-bg">
                                        <MudSkeleton Width="120px" Height="20px" Class="mb-2" />
                                        <MudSkeleton Width="100%" Height="70px" SkeletonType="SkeletonType.Rectangle" />
                                    </div>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else if (_dailyError is not null || _habitError is not null)
                    {
                        <div class="stats-inline-fallback">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="stats-inline-fallback__icon" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Some graphs couldn't load. Try again or change the period.</MudText>
                        </div>
                    }
                    else
                    {
                        var showHabits = _consistencyTab is "all" or "habit";
                        var showDailies = _consistencyTab is "all" or "daily";
                        var habitCount = _habitView?.Graphs.Count ?? 0;
                        var dailyCount = _dailyView?.Graphs.Count ?? 0;
                        var totalVisible = (showHabits ? habitCount : 0) + (showDailies ? dailyCount : 0);

                        @if (totalVisible == 0)
                        {
                            <div class="stats-empty">
                                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Class="stats-empty__icon" />
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">No graphs for this filter</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">Try All or add a @(_consistencyTab == "daily" ? "daily" : "habit") to your board.</MudText>
                            </div>
                        }
                        else
                        {
                            <MudGrid Spacing="3" Class="mt-3 stats-consistency-grid">
                                @if (showDailies && _dailyView is not null)
                                {
                                    @foreach (var daily in _dailyView.Graphs)
                                    {
                                        var cellIx = GetDailyCellIndex(daily);
                                        <MudItem xs="12" md="6">
                                            <div class="stats-daily-block pa-3 border rounded stats-block-bg">
                                                <div class="d-flex align-center justify-space-between gap-2 mb-2">
                                                    <span class="stats-daily-title">@daily.Title</span>
                                                    <span class="stats-habit-ratio" title="@DailyActiveRatioTooltip(daily)">@DailyActiveRatioLabel(daily)</span>
                                                </div>
                                                <StatsHeatmapGrid Columns="daily.GridWeekColumns"
                                                                   Cells="cellIx"
                                                                   ShowMonthLabels="false"
                                                                   IsToday="@((r, c) => cellIx.TryGetValue((r, c), out var cell) && IsHeatmapToday(cell.Date))"
                                                                   GetCellClass="@((r, c) => DailyHeatmapCellClass(cellIx[(r, c)]))"
                                                                   GetCellTitle="@((r, c) => DailyHeatmapDayTitle(cellIx[(r, c)].Date, cellIx[(r, c)].Count))"
                                                                   GetCellAriaLabel="@((r, c) => DailyHeatmapDayTitle(cellIx[(r, c)].Date, cellIx[(r, c)].Count))"/>
                                            </div>
                                        </MudItem>
                                    }
                                }
                                @if (showHabits && _habitView is not null)
                                {
                                    @foreach (var habit in _habitView.Graphs)
                                    {
                                        var cellIx = GetHabitCellIndex(habit);
                                        <MudItem xs="12" md="6">
                                            <div class="stats-habit-block pa-3 border rounded stats-block-bg">
                                                <div class="d-flex align-center justify-space-between gap-2 mb-2">
                                                    <span class="stats-habit-title">@habit.Title</span>
                                                    <span class="stats-habit-ratio" title="@FormatHabitRatioTooltip(habit.ActiveDayCount, habit.PeriodDayCount)">@HabitActiveRatioLabel(habit.ActiveDayCount, habit.PeriodDayCount)</span>
                                                </div>
                                                <StatsHeatmapGrid Columns="habit.GridWeekColumns"
                                                                   Cells="cellIx"
                                                                   ShowMonthLabels="false"
                                                                   IsToday="@((r, c) => cellIx.TryGetValue((r, c), out var cell) && IsHeatmapToday(cell.Date))"
                                                                   GetCellClass="@((r, c) => HabitHeatmapCellClass(cellIx[(r, c)]))"
                                                                   GetCellTitle="@((r, c) => HabitHeatmapDayTitle(cellIx[(r, c)].Date, cellIx[(r, c)].Count))"
                                                                   GetCellAriaLabel="@((r, c) => HabitHeatmapDayTitle(cellIx[(r, c)].Date, cellIx[(r, c)].Count))"/>
                                            </div>
                                        </MudItem>
                                    }
                                }
                                @if (showHabits && habitCount == 0 && _consistencyTab == "all")
                                {
                                    <MudItem xs="12" md="6">
                                        <div class="stats-empty stats-empty--inline">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">No habits yet. Add one to see active day ratio.</MudText>
                                        </div>
                                    </MudItem>
                                }
                                @if (showDailies && dailyCount == 0 && _consistencyTab == "all")
                                {
                                    <MudItem xs="12" md="6">
                                        <div class="stats-empty stats-empty--inline">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">No dailies yet. Add one to track streaks.</MudText>
                                        </div>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                    }
                </MudPaper>
            </div>

            <div class="stats-dashboard-sidebar">
                <div class="stats-sidebar-column">
                    <MudPaper Class="pa-4 stats-dashboard-card stats-filter-card" Elevation="0" Outlined="true">
                        <MudStack Spacing="2">
                            <div class="stats-filter-card__header">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Filters</MudText>
                            </div>
                            <div class="stats-filter-row">
                                <MudSelect T="string"
                                           Label="Tags"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Margin="Margin.Dense"
                                           MultiSelection="true"
                                           SelectAll="true"
                                           SelectAllText="All tags"
                                           Adornment="Adornment.Start"
                                           AdornmentIcon="@Icons.Material.Outlined.LocalOffer"
                                           MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectionText))"
                                           SelectedValues="_selectedTags"
                                           SelectedValuesChanged="OnSelectedTagsChanged"
                                           Clearable="true"
                                           Disabled="@((_data.AvailableTags?.Count ?? 0) == 0)"
                                           AnchorOrigin="Origin.BottomLeft"
                                           TransformOrigin="Origin.TopLeft"
                                           MaxHeight="300"
                                           Style="width:100%"
                                           Class="stats-tag-select-sidebar">
                                    @if ((_data.AvailableTags?.Count ?? 0) > 0)
                                    {
                                        @foreach (var t in _data.AvailableTags ?? [])
                                        {
                                            <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
                                        }
                                    }
                                    else
                                    {
                                        <MudSelectItem T="string" Value="@(string.Empty)" Disabled="true">No tags created yet</MudSelectItem>
                                    }
                                </MudSelect>

                                <MudSelect T="string"
                                           Label="Period"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Margin="Margin.Dense"
                                           Adornment="Adornment.Start"
                                           AdornmentIcon="@Icons.Material.Outlined.DateRange"
                                           Value="_selectedPeriodKey"
                                           ValueChanged="OnStatsPeriodChanged"
                                           AnchorOrigin="Origin.BottomLeft"
                                           TransformOrigin="Origin.TopLeft"
                                           MaxHeight="300"
                                           Style="width:100%"
                                           Class="stats-year-select-sidebar">
                                    @if (_periodOptions is not null)
                                    {
                                        @foreach (var opt in _periodOptions)
                                        {
                                            <MudSelectItem T="string" Value="@opt.Key">@opt.Label</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </div>

                            @if (_selectedTags.Count > 0)
                            {
                                <div class="d-flex flex-wrap align-center gap-1 mt-1">
                                    @foreach (var tag in _selectedTags)
                                    {
                                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" OnClose="() => OnRemoveTagFilterAsync(tag)" Class="ma-0">@tag</MudChip>
                                    }
                                    @if (_selectedTags.Count > 1)
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" OnClick="OnClearTagFiltersAsync" Class="pa-0 min-w-0 font-size-xs ms-1">Clear all</MudButton>
                                    }
                                </div>
                            }

                            @if (_periodBusy)
                            {
                                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-0"/>
                            }

                            <div class="stats-sidebar-range">
                                <span class="stats-sidebar-range__label">Range</span>
                                <span class="stats-sidebar-range__value">@FormatRange(_data.RangeStart, _data.RangeEnd)</span>
                            </div>
                        </MudStack>
                    </MudPaper>

                    <div class="stats-kpi-cards stats-kpi-cards--desktop">
                        @foreach (var kpi in Kpis(_data))
                        {
                            <MudPaper Class="@($"stats-kpi-card stats-kpi-card--sidebar stats-kpi-card--plain {kpi.CardAccent}")" Elevation="0" Outlined="false">
                                <div class="stats-kpi-card__head">
                                    <MudText Typo="Typo.caption" Class="stats-kpi-card__label">@kpi.CardLabel</MudText>
                                    <MudIcon Icon="@kpi.Icon" Class="stats-kpi-card__icon" Size="Size.Small" aria-hidden="true"/>
                                </div>
                                <MudText Typo="Typo.h6" Class="stats-kpi-card__value">@kpi.CardValue()</MudText>
                            </MudPaper>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</MudStack>

@code {
    private string _consistencyTab = "all";
}
